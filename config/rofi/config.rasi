configuration {
  modi: "calc,emoji";
  show-icons: true;
  icon-theme: "Adwaita";
  display-calc: "󰃬  Calc";
  display-emoji: "󰞅  Emoji";
  drun-display-format: "{name}";
  font: "JetBrainsMono Nerd Font 12";
  matching: "fuzzy";
  sort: true;
  sorting-method: "fzf";
  /* Tab / Shift+Tab switch tabs */
  kb-mode-next: "Tab,Control+Tab";
  kb-mode-previous: "ISO_Left_Tab,Control+ISO_Left_Tab";
  kb-element-next: "";
  kb-element-prev: "";
}

@theme "~/.config/rofi/theme.rasi"
