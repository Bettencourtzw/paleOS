#!/usr/bin/env bash
choice=$(printf '󰌾  Lock
󰒲  Suspend
󰍃  Log out
󰜉  Restart
󰐥  Shut down
' | rofi -dmenu -i -p "" -theme-str 'mainbox {children: [inputbar, listview];} window {width: 300px;} listview {lines: 5;} entry {placeholder: "System";}')
case "$choice" in
  *Lock)      pidof hyprlock || hyprlock ;;
  *Suspend)   systemctl suspend ;;
  *"Log out") hyprctl dispatch 'hl.dsp.exit()' ;;
  *Restart)   systemctl reboot ;;
  *"Shut down") systemctl poweroff ;;
esac
