#!/usr/bin/env python3
"""paleos-apply — turn ~/.config/paleos/settings.json (written by the Customize app) into config files."""
import json, os, re, subprocess

H = os.path.expanduser
S = {"barPosition": "top", "gaps": 12, "rounding": 10, "animations": True, "screensaverMinutes": 5, "lockMinutes": 10}
try: S.update(json.load(open(H("~/.config/paleos/settings.json"))))
except (OSError, ValueError): pass

def write_if_changed(path, text):
    old = open(path).read() if os.path.exists(path) else None
    if old != text:
        os.makedirs(os.path.dirname(path), exist_ok=True); open(path, "w").write(text)
    return old != text

def restart(name, *cmd):
    subprocess.run(["pkill", "-x", name])
    subprocess.Popen(list(cmd) or [name], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# windows: gaps, rounding, animations -> ~/.config/hypr/paleos.lua (loaded last by hyprland.lua)
g = int(S["gaps"])
write_if_changed(H("~/.config/hypr/paleos.lua"),
    "-- Written by the Customize app (paleos-apply). Change it there, not here.\n"
    f"hl.config({{ general = {{ gaps_in = {max(0, g // 2 - 1)}, gaps_out = {g} }}, "
    f"decoration = {{ rounding = {int(S['rounding'])} }}, animations = {{ enabled = {str(bool(S['animations'])).lower()} }} }})\n")
subprocess.run(["hyprctl", "reload"], capture_output=True)

# idle: screensaver + lock
idle = "general {\n    lock_cmd = pidof hyprlock || hyprlock\n    before_sleep_cmd = loginctl lock-session\n}\n"
if S["screensaverMinutes"] > 0:
    idle += f"\nlistener {{\n    timeout = {S['screensaverMinutes'] * 60}\n    on-timeout = ~/.local/bin/screensaver\n}}\n"
if S["lockMinutes"] > 0:
    idle += f"\nlistener {{\n    timeout = {S['lockMinutes'] * 60}\n    on-timeout = loginctl lock-session\n}}\n"
if write_if_changed(H("~/.config/hypr/hypridle.conf"), idle):
    restart("hypridle")

# top bar position
wb = H("~/.config/waybar/config.jsonc")
if os.path.exists(wb):
    t = open(wb).read(); pos = S["barPosition"]; other = "bottom" if pos == "top" else "top"
    n = re.sub(r'"position": "\w+"', f'"position": "{pos}"', t)
    n = re.sub(rf'"margin-{other}": (\d+)', rf'"margin-{pos}": \1', n)
    if write_if_changed(wb, n):
        subprocess.run(["systemctl", "--user", "restart", "waybar"])
