#!/usr/bin/env bash
# Network speed test (Cloudflare). Prints: "ping <ms>", "down <Mbps>", "up <Mbps>"
ping_ms=$(curl -s -o /dev/null -w '%{time_connect}' https://speed.cloudflare.com/__down?bytes=0 | awk '{printf "%.0f", $1*1000}')
echo "ping $ping_ms"
t0=$(date +%s%N)
for i in 1 2 3 4; do curl -s -o /dev/null --max-time 20 "https://speed.cloudflare.com/__down?bytes=50000000" & done; wait
down=$(( 200000000 * 8 / ( ($(date +%s%N) - t0) / 1000 ) ))   # bits per microsecond = Mbps
echo "down $down"
up=$(head -c 50000000 /dev/urandom | curl -s -o /dev/null -w '%{speed_upload}' --max-time 15 -X POST --data-binary @- https://speed.cloudflare.com/__up | awk '{printf "%.0f", $1*8/1000000}')
echo "up $up"
