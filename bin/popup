#!/usr/bin/env bash
# popup <window-class> <command...>
# Opens the app as a floating popup under the bar; clicking again closes it.
class="$1"; shift
pid=$(hyprctl clients -j | jq -r --arg c "$class" '.[] | select(.class == $c) | .pid' | head -1)
if [ -n "$pid" ]; then kill "$pid"; else setsid -f "$@" >/dev/null 2>&1; fi
