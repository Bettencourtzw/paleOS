#!/usr/bin/env bash
# Start Steam, and close the Friends List window if Steam pops it open at startup.
# (Opening Friends yourself later still works normally.)
running=$(pgrep -x steam)
setsid -f /usr/bin/steam "$@" >/dev/null 2>&1
[ -n "$running" ] && exit 0   # already running: nothing to clean up
for _ in $(seq 1 80); do
  a=$(hyprctl clients -j | jq -r '.[] | select(.class=="steam" and (.title|test("^Friends List"))) | .address' | head -1)
  if [ -n "$a" ]; then hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null; exit 0; fi
  sleep 0.5
done
