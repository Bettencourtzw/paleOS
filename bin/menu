#!/usr/bin/env bash
# Sections of the SUPER+SPACE menu.
#   menu <section>          -> list rows
#   menu <section> <label>  -> run it (print "GOTO:<section>" to open a sub-menu)
# To add an entry: add a `row icon "Label"` line and a matching case line.
I=~/.local/share/menu-icons
row()   { printf '%s\0icon\x1f%s\n' "$2" "$I/$1.svg"; }
run()   { setsid -f bash -c "$1" >/dev/null 2>&1; }
term()  { setsid -f foot -e bash -c "$1"'; echo; read -n1 -p "Done. Press any key to close."' >/dev/null 2>&1; }
edit()  { setsid -f foot -e nvim "$@" >/dev/null 2>&1; }
web()   { setsid -f xdg-open "$1" >/dev/null 2>&1; }
panel() { run "qs ipc call panel toggle $1"; }
need_yay() { command -v yay >/dev/null || { notify-send "AUR helper needed" "Install it first: Install → AUR helper (yay)"; return 1; }; }
sec="$1"; pick="$2"

case "$sec" in
learn)
  [ -z "$pick" ] && { row keys "Keybindings"; row web "Hyprland"; row web "Arch Wiki"; row web "Bash"; exit; }
  case "$pick" in
    "Keybindings") run ~/.local/bin/keybinds-menu ;;
    "Hyprland") web "https://wiki.hypr.land/" ;;
    "Arch Wiki") web "https://wiki.archlinux.org/" ;;
    "Bash") web "https://devhints.io/bash" ;;
  esac ;;






install)
  [ -z "$pick" ] && { row package "Package"; row package "AUR package"; row package "Apps"; row web "Browser"; row edit "Editor"; row trigger "Terminal"
                      row keys "Development"; row display "Gaming"; row web "Web App"; row restart "Service"; row package "AUR helper (yay)"; exit; }
  case "$pick" in
    "Package") term 'pacman -Slq | fzf --multi --preview "pacman -Si {}" --prompt "Install > " | xargs -ro sudo pacman -S --needed' ;;
    "AUR package") need_yay && term 'yay -Slqa | fzf --multi --preview "yay -Si {}" --prompt "AUR > " | xargs -ro yay -S --needed' ;;
    "Web App") run "~/.local/bin/webapp add" ;;
    "AUR helper (yay)") term 'command -v yay && { echo "yay is already installed"; exit; }; sudo pacman -S --needed --noconfirm base-devel git && d=$(mktemp -d) && git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$d" && cd "$d" && makepkg -si --noconfirm; rm -rf "$d"' ;;
    *) echo "GOTO:install-${pick,,}" ;;
  esac ;;

install-apps|install-browser|install-editor|install-terminal|install-development|install-gaming|install-service)
  # "Label|how" — how: pac <pkgs> · aur <pkgs> · run <shell command>
  case "$sec" in
    install-apps) list=("Calculator|pac gnome-calculator") ;;
    install-browser) list=("Firefox|pac firefox" "Chromium|pac chromium" "Brave|aur brave-bin" "Zen Browser|aur zen-browser-bin" "Google Chrome|aur google-chrome") ;;
    install-editor) list=("VS Code (open source)|pac code" "Zed|pac zed" "Helix|pac helix" "Neovim + LazyVim|run sudo pacman -S --needed neovim git ripgrep fd lazygit && [ ! -e ~/.config/nvim ] && git clone https://github.com/LazyVim/starter ~/.config/nvim && rm -rf ~/.config/nvim/.git") ;;
    install-terminal) list=("Ghostty|pac ghostty" "Alacritty|pac alacritty" "Kitty|pac kitty" "WezTerm|pac wezterm") ;;
    install-development) list=("Rust|pac rustup && rustup default stable" "Go|pac go" "Node.js|pac nodejs npm" "Python (uv)|pac python uv" "Java|pac jdk-openjdk" "C / C++|pac base-devel clang cmake gdb" "Docker|run sudo pacman -S --needed docker docker-compose docker-buildx && sudo systemctl enable --now docker && sudo usermod -aG docker $USER && echo 'Log out and back in to use docker without sudo.'" "GitHub CLI|pac github-cli") ;;
    install-gaming) list=("Steam|run grep -q '^\[multilib\]' /etc/pacman.conf || sudo sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf; sudo pacman -Syu --needed steam" "Lutris|pac lutris" "Heroic (Epic, GOG)|aur heroic-games-launcher-bin" "MangoHud (FPS overlay)|pac mangohud $(grep -q '^\[multilib\]' /etc/pacman.conf && echo lib32-mangohud)" "Prism Launcher (Minecraft)|pac prismlauncher" "Gamescope|pac gamescope") ;;
    install-service) list=("Tailscale (VPN)|run sudo pacman -S --needed tailscale && sudo systemctl enable --now tailscaled && sudo tailscale up" "Syncthing|run sudo pacman -S --needed syncthing && systemctl --user enable --now syncthing" "Printing|run sudo pacman -S --needed cups cups-pdf system-config-printer && sudo systemctl enable --now cups.socket" "Flatpak|pac flatpak") ;;
  esac
  [ -z "$pick" ] && { for i in "${list[@]}"; do row package "${i%%|*}"; done; exit; }
  for i in "${list[@]}"; do [ "${i%%|*}" = "$pick" ] && { how=${i#*|}; break; }; done
  case "$how" in
    pac\ *) term "sudo pacman -S --needed ${how#pac }" ;;
    aur\ *) need_yay && term "yay -S --needed ${how#aur }" ;;
    run\ *) term "${how#run }" ;;
  esac ;;

remove)
  [ -z "$pick" ] && { row package "Package"; row web "Web App"; exit; }
  case "$pick" in
    "Package") term 'pacman -Qeq | fzf --multi --preview "pacman -Qi {}" --prompt "Remove > " | xargs -ro sudo pacman -Rns' ;;
    "Web App") echo "GOTO:remove-webapp" ;;
  esac ;;

remove-webapp)
  [ -z "$pick" ] && { for f in ~/.local/share/applications/webapp-*.desktop; do [ -e "$f" ] && row web "$(sed -n 's/^Name=//p' "$f")"; done; exit; }
  for f in ~/.local/share/applications/webapp-*.desktop; do
    [ "$(sed -n 's/^Name=//p' "$f")" = "$pick" ] && { rm -f "$f" ~/.local/share/icons/webapps/"$(basename "$f" .desktop)".png; notify-send -u low "Removed $pick"; }
  done ;;

update)
  [ -z "$pick" ] && { row update "System"; row update "paleOS"; row restart "Restart top bar"; row restart "Restart panels"; exit; }
  case "$pick" in
    "System") term "sudo pacman -Syu" ;;
    "paleOS") term "~/.local/bin/paleos-update" ;;
    "Restart top bar") run "systemctl --user restart waybar" ;;
    "Restart panels") run "systemctl --user restart paleos-shell" ;;
  esac ;;


system)
  [ -z "$pick" ] && { row system "Power settings"; row lock "Lock"; row sleep "Suspend"; row logout "Log out"; row reboot "Restart"; row shutdown "Shut down"
                      command -v powerprofilesctl >/dev/null && row about "Power mode"
                      exit; }
  case "$pick" in
    "Power settings") panel power ;;
    "Lock") run "pidof hyprlock || hyprlock" ;; "Suspend") run "systemctl suspend" ;;
    "Log out") run "hyprctl dispatch 'hl.dsp.exit()'" ;;
    "Restart") run "systemctl reboot" ;; "Shut down") run "systemctl poweroff" ;;
    "Power mode") echo "GOTO:power-mode" ;;
  esac ;;

power-mode)   # all power modes in one place
  [ -z "$pick" ] && { cur=$(powerprofilesctl get 2>/dev/null)
    for p in Performance Balanced "Power saver"; do id=$(tr 'A-Z ' 'a-z-' <<<"$p"); row about "$p$( [ "$id" = "$cur" ] && echo '  ✓')"; done; exit; }
  id=$(tr 'A-Z ' 'a-z-' <<<"${pick%%  *}"); powerprofilesctl set "$id" && notify-send -u low "Power mode" "${pick%%  *}" ;;
esac
