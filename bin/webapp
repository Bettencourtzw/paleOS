#!/usr/bin/env bash
# webapp add            -> asks for a name + address, adds it to the app menu (own window, own icon)
# webapp launch <url>   -> opens the address as an app window in your default browser
set -euo pipefail
apps=~/.local/share/applications icons=~/.local/share/icons/webapps
input() { rofi -dmenu -p "" -theme-str "mainbox {children: [inputbar];} entry {placeholder: \"$1\";}" </dev/null; }

case "${1:-}" in
launch)
  b=$(xdg-settings get default-web-browser 2>/dev/null || true)
  case "$b" in
    *chrom*|*brave*|*edge*|*vivaldi*)                                   # Chromium-based: real app window
      for d in ~/.local/share/applications /usr/local/share/applications /usr/share/applications; do
        [[ -f $d/$b ]] || continue
        exe=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$d/$b" | head -1)
        [[ -n $exe ]] && exec $exe --app="$2"
      done ;;
  esac
  exec xdg-open "$2" ;;
add)
  name=$(input "Web app name (e.g. YouTube)") || exit 0
  url=$(input "Address (e.g. youtube.com)") || exit 0
  [[ -n $name && -n $url ]] || exit 0
  url=${url//[[:space:]]/}
  [[ $url == http* ]] || url="https://$url"
  id="webapp-$(tr -cs 'a-z0-9' '-' <<<"${name,,}" | sed 's/^-*//; s/-*$//')"
  [[ $id == webapp- ]] && id="webapp-$(date +%s)"
  mkdir -p "$apps" "$icons"
  curl -fsSL --max-time 8 -o "$icons/$id.png" "https://www.google.com/s2/favicons?sz=128&domain_url=$url" || rm -f "$icons/$id.png"
  cat > "$apps/$id.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$name
Exec=$HOME/.local/bin/webapp launch "$(sed 's/[\\"`$]/\\&/g; s/%/%%/g' <<<"$url")"
Icon=$icons/$id.png
Categories=Network;
DESKTOP
  notify-send -u low "Web app added" "$name is in the app menu" ;;
*) sed -n '2,3p' "$0"; exit 2 ;;
esac
