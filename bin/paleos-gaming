#!/usr/bin/env bash
# Shared Steam setup for the ISO and the desktop menu.
set -euo pipefail
[[ $EUID -eq 0 || ${PALEOS_GAMING_DRYRUN:-} == 1 ]] || exec sudo bash "$0" "$@"
gpu=$(lspci -nn | grep -E '(VGA|3D|Display)' || true)
pkgs=(steam gamemode lib32-gamemode)
[[ $gpu != *'[1002:'* ]] || pkgs+=(vulkan-radeon lib32-vulkan-radeon)
[[ $gpu != *'[8086:'* ]] || pkgs+=(vulkan-intel lib32-vulkan-intel)
if [[ $gpu == *'[10de:'* ]]; then
  utils=$(pacman -Qq | grep -E '^nvidia(-[0-9]+xx|-beta)?-utils$' || true)
  [[ $utils == nvidia-utils ]] || { echo "Install matching NVIDIA and 32-bit Vulkan drivers for your driver series before installing Steam."; exit 1; }
  pkgs+=(nvidia-utils lib32-nvidia-utils)
fi
(( ${#pkgs[@]} > 3 )) || { echo "No supported Vulkan GPU detected; configure its 64-bit and 32-bit Vulkan driver before installing Steam."; exit 1; }
if [[ ${PALEOS_GAMING_DRYRUN:-} == 1 ]]; then printf '%s\n' "${pkgs[@]}"; exit; fi
if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
  cp -a /etc/pacman.conf "/etc/pacman.conf.paleos-$(date +%s)"
  sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf
fi
grep -q '^\[multilib\]' /etc/pacman.conf || { echo "Enable multilib in /etc/pacman.conf first."; exit 1; }
pacman -Syu --needed "${pkgs[@]}"
