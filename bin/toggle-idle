#!/usr/bin/env bash
# SUPER+CTRL+I: turn the screensaver / lock / suspend on idle off and on. hypridle keeps running (it also
# locks before sleep and handles "Lock"); "off" is a systemd idle inhibitor, which hypridle respects.
if pkill -f '^systemd-inhibit --what=idle --who=paleOS'; then notify-send -u low "Idle lock enabled"
else setsid -f systemd-inhibit --what=idle --who=paleOS --why="Idle lock off (SUPER+CTRL+I)" sleep infinity >/dev/null 2>&1
     notify-send -u low "Idle lock disabled"; fi
